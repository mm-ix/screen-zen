<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/overlay_scrim">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp">

        <FrameLayout
            android:layout_width="@dimen/overlay_circle_size"
            android:layout_height="@dimen/overlay_circle_size">

            <com.screenzen.app.ui.widget.BreathCircleView
                android:id="@+id/breath_circle"
                android:layout_width="@dimen/overlay_circle_size"
                android:layout_height="@dimen/overlay_circle_size"
                android:layout_gravity="center" />

            <TextView
                android:id="@+id/countdown_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="10"
                android:textColor="@color/overlay_text_primary"
                android:textSize="@dimen/overlay_countdown"
                tools:ignore="HardcodedText" />
        </FrameLayout>

        <TextView
            android:id="@+id/app_name_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="@color/overlay_text_primary"
            android:textSize="18sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/overlay_breath_hint"
            android:textColor="@color/overlay_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 一直显示，不设延迟 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/abandon_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/overlay_button_margin"
        android:text="@string/overlay_abandon"
        android:textColor="@color/overlay_text_primary"
        app:backgroundTint="@color/overlay_button_bg"
        app:cornerRadius="26dp" />
</FrameLayout>
