    <!-- 引导页 -->
    <string name="onboarding_title">权限引导</string>
    <string name="onboarding_intro">四个开关都打开，拦截才能稳定生效。每一步都有状态检测，点右侧按钮去设置。</string>
    <string name="onboarding_step_accessibility">1. 无障碍服务</string>
    <string name="onboarding_step_accessibility_desc">检测当前打开的是哪个 App，并用它回到桌面。这是拦截的基础。</string>
    <string name="onboarding_step_overlay">2. 悬浮窗</string>
    <string name="onboarding_step_overlay_desc">用来盖住全屏的呼吸遮罩。</string>
    <string name="onboarding_step_usage">3. 使用情况访问</string>
    <string name="onboarding_step_usage_desc">读取今日各 App 使用时长，用于统计。不开启只影响统计，不影响拦截。</string>
    <string name="onboarding_step_battery">4. 电池优化白名单</string>
    <string name="onboarding_step_battery_desc">让系统不要为了省电把拦截服务杀掉。</string>
    <string name="onboarding_step_keepalive">5. 保活授权（重启后仍生效）</string>
    <string name="onboarding_step_keepalive_desc">允许本应用自己写回无障碍开关，手机重启后不用手动重开。需要电脑上用 adb 执行一次命令，授权永久有效。</string>
    <string name="onboarding_step_autostart">6. 自启动（国产 ROM 建议开）</string>
    <string name="onboarding_step_autostart_desc">部分系统没有公开接口，点进去自行找到本应用并允许自启动。</string>
    <string name="onboarding_action_go">去开启</string>
    <string name="onboarding_action_done">已开启</string>
    <string name="onboarding_action_copy">复制命令</string>
    <string name="onboarding_status_missing">未开启</string>
    <string name="onboarding_status_unknown">建议开启</string>
    <string name="onboarding_copied">命令已复制，粘贴到电脑终端执行</string>
    <string name="onboarding_adb_format">adb shell pm grant %1$s android.permission.WRITE_SECURE_SETTINGS</string>
    <string name="onboarding_adb_hint">把手机用数据线连到电脑，在电脑终端里执行上面这条命令（本机已装 adb，可直接粘贴）。</string>
    <string name="onboarding_summary_format">拦截 %1$d 个应用 · 倒计时 %2$d 秒</string>

